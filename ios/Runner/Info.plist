<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>NSCameraUsageDescription</key>
	<string>Catwalk uses the camera only when you tap Take a photo of a street cat. Photos stay on your phone.</string>
	<key>CADisableMinimumFrameDurationOnPhone</key>
	<true/>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleDisplayName</key>
	<string>Catwalk</string>
	<key>NSHealthShareUsageDescription</key>
	<string>Catwalk reads your step count so your cat knows how far you walked today.</string>
	<key>NSHealthUpdateUsageDescription</key>
	<string>Catwalk does not write to Apple Health.</string>
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>Catwalk shows pickups near you and helps you find a cat that ran away. Only while the app is open, and it stays on your phone.</string>
	<key>NSMotionUsageDescription</key>
	<string>Catwalk reads your phone's step sensor when Apple Health cannot answer.</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
