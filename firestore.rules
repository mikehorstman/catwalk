rules_version = '2';

// Catwalk. Local save is the source of truth for walking; Firestore only
// holds the social layer (profiles, friends, nudges, leaderboard).
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function isOwner(uid) { return signedIn() && request.auth.uid == uid; }
    // Anonymous accounts can keep their own data but stay out of the social graph.
    function isRealUser() {
      return signedIn() && request.auth.token.firebase.sign_in_provider != 'anonymous';
    }

    // Public profile: name, level, streak, today's steps, cat/room summary.
    // Readable by real users (friends, leaderboard, room visits). Only the owner writes.
    match /users/{uid} {
      allow read: if isRealUser() || isOwner(uid);
      allow create, update: if isOwner(uid)
        && request.resource.data.keys().hasOnly([
          'displayName', 'photoUrl', 'level', 'xp', 'streak', 'bestStreak',
          'todaySteps', 'dailyGoal', 'cats', 'room', 'updatedAt'])
        && (!('displayName' in request.resource.data)
            || (request.resource.data.displayName is string
                && request.resource.data.displayName.size() <= 40));
      allow delete: if isOwner(uid);

      // Private to the owner: settings, push tokens, backups.
      match /private/{doc} {
        allow read, write: if isOwner(uid);
      }
    }

    // Friend requests. id = "<fromUid>_<toUid>".
    match /friendRequests/{id} {
      allow read: if isRealUser()
        && (resource.data.from == request.auth.uid || resource.data.to == request.auth.uid);
      allow create: if isRealUser()
        && request.resource.data.from == request.auth.uid
        && request.resource.data.to is string
        && request.resource.data.to != request.auth.uid
        && request.resource.data.keys().hasOnly(['from', 'to', 'createdAt'])
        && id == request.auth.uid + '_' + request.resource.data.to;
      // Either side may cancel/decline.
      allow delete: if isRealUser()
        && (resource.data.from == request.auth.uid || resource.data.to == request.auth.uid);
    }

    // Friendships. id = the two uids sorted, joined by "_". Created only by
    // the recipient of a pending request, so nobody can add themselves to you.
    match /friendships/{id} {
      allow read: if isRealUser() && request.auth.uid in resource.data.members;
      allow create: if isRealUser()
        && request.resource.data.keys().hasOnly(['members', 'createdAt'])
        && request.resource.data.members.size() == 2
        && request.auth.uid in request.resource.data.members
        && exists(/databases/$(database)/documents/friendRequests/
             $(request.resource.data.members[0] == request.auth.uid
                 ? request.resource.data.members[1] + '_' + request.auth.uid
                 : request.resource.data.members[0] + '_' + request.auth.uid));
      allow delete: if isRealUser() && request.auth.uid in resource.data.members;
    }

    // Nudges to a friend who hasn't hit their goal. Recipient reads/clears.
    match /nudges/{id} {
      allow read, delete: if isRealUser() && resource.data.to == request.auth.uid;
      allow create: if isRealUser()
        && request.resource.data.from == request.auth.uid
        && request.resource.data.to is string
        && request.resource.data.keys().hasOnly(['from', 'to', 'createdAt'])
        && request.resource.data.to != request.auth.uid
        && exists(/databases/$(database)/documents/friendships/
             $(request.auth.uid < request.resource.data.to
                 ? request.auth.uid + '_' + request.resource.data.to
                 : request.resource.data.to + '_' + request.auth.uid));
      allow update: if false;
    }

    // Everything else is closed.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
